{
  "name": "@cfo-ia/database",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cfo-ia/domain": "workspace:*",
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@cfo-ia/eslint-config": "workspace:*",
    "@cfo-ia/typescript-config": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.16.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
