# Required in production. PostgreSQL/Neon connection string. Secret.
DATABASE_URL=

# Integration tests only. Must use a separate PostgreSQL database. Secret.
TEST_DATABASE_URL=

# Injected by Railway in production; defaults to 3001 locally when omitted.
PORT=

# Runtime environment: development, test, or production.
NODE_ENV=

# Required for photo and PDF interpretation. Secret.
OPENAI_API_KEY=

# Required for photo and PDF interpretation.
OPENAI_MODEL=

# Optional OpenAI request timeout in milliseconds.
OPENAI_TIMEOUT_MS=

# Required for Telegram long polling. Secret.
TELEGRAM_BOT_TOKEN=

# Required for the single-user Telegram adapter.
TELEGRAM_WORKSPACE_ID=
TELEGRAM_API_USER_ID=

# Optional. Omit in production to call the API through 127.0.0.1 and PORT.
TELEGRAM_INTERNAL_API_URL=

# Web application only; not required by the API service.
NEXT_PUBLIC_API_URL=

# PAE remains disabled for this deployment.
PAE_ENABLED=
PAE_SESSION_TIMEOUT_MS=
PAE_SCREENSHOT_DIR=
PAE_BROWSER_EXECUTABLE_PATH=
