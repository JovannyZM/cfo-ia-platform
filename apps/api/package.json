    "pae:smoke:chromium": "node dist/portal-automation/smoke-chromium.js",
    "invoice:retry": "node dist/invoice-requests/retry-invoice-request.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cfo-ia/config": "workspace:*",
    "@cfo-ia/database": "workspace:*",
    "@cfo-ia/domain": "workspace:*",
    "@napi-rs/canvas": "^1.0.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^6.1.0",
    "openai": "^6.16.0",
    "pdfjs-dist": "^3.11.174",
    "playwright": "^1.62.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cfo-ia/eslint-config": "workspace:*",
    "@cfo-ia/typescript-config": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.3",
    "dotenv": "^16.4.7",
    "eslint": "^9.16.0",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.8"
