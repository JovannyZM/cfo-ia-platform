{
  "name": "cfo-ia-platform",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @cfo-ia/api test:integration",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "db:generate": "dotenv -e .env -- pnpm --filter @cfo-ia/database generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @cfo-ia/database migrate",
    "db:deploy": "pnpm --filter @cfo-ia/database migrate:deploy",
    "db:seed": "dotenv -e .env -- pnpm --filter @cfo-ia/database seed",
    "db:backfill-budgets": "dotenv -e .env -- pnpm --filter @cfo-ia/api backfill:expense-budgets",
    "pae:probe:costco": "dotenv -e .env -- pnpm --filter @cfo-ia/api pae:probe:costco",
    "pae:probe:costco:controlled": "dotenv -e .env -- pnpm --filter @cfo-ia/api pae:probe:costco:controlled"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
